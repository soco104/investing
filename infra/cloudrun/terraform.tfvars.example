project_id = "your-gcp-project-id"
region     = "us-east1"

service_name        = "futurefund-classroom"
artifact_repository = "futurefund"

# Optional for the first apply. Terraform defaults to a public hello image so
# the Artifact Registry repo and Cloud Run service can be created before the
# first FutureFund image exists. Replace after Cloud Build pushes the app image.
# image = "us-east1-docker.pkg.dev/your-gcp-project-id/futurefund/futurefund-classroom:initial"

allow_unauthenticated = true
min_instances         = 1
max_instances         = 5

db_instance_name = "futurefund-db"
db_name          = "futurefund"
db_user          = "futurefund_app"
db_tier          = "db-f1-micro"

# Optional first admin. Generate the bcrypt hash after npm install with:
# node -e "require('bcryptjs').hash('change-me', 12).then(console.log)"
bootstrap_admin_email         = "admin@example.edu"
bootstrap_admin_password_hash = ""

market_poll_schedule = "*/15 8-15 * * 1-5"
market_poll_timezone = "America/New_York"

# Optional district SSO initiation. Store client secrets through the Credential Vault.
sso_authorization_url = ""
sso_client_id         = ""
sso_redirect_uri      = ""
sso_scope             = "openid email profile"
